# Strava OAuth credentials (from https://www.strava.com/settings/api)
VITE_STRAVA_CLIENT_ID=your_strava_client_id_here

# OAuth redirect URI (must match what's registered in Strava)
VITE_STRAVA_REDIRECT_URI=http://localhost:3000/auth/callback

# Backend API URL (Vite dev server proxies /api to this)
VITE_API_URL=http://localhost:8000

# Mapbox access token for route visualization
VITE_MAPBOX_TOKEN=your_mapbox_token_here
