# Application
APP_NAME=Strava Trends API
DEBUG=false

# Database
# Default matches the docker-compose.yml dev database (port 5432) — see README "The Two Databases".
# Do NOT point this at port 5433; that is the pytest database used only by `make test`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strava_trends

# Strava OAuth (optional - leave empty if not using Strava sync)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# Garmin Personal API (optional - leave empty if not using Garmin sync)
# Create a key: Garmin Connect Web -> Settings -> Personal API Key
# (key is shown ONCE at creation; expiry max 1 year)
# Expiry format: ISO date YYYY-MM-DD (US MM/DD/YYYY also accepted)
GARMIN_API_KEY=
GARMIN_API_KEY_EXPIRES_AT=
# Optional: where downloaded original FIT files are cached (re-syncs skip re-downloads)
# GARMIN_FIT_CACHE_DIR=

# Authentication
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
